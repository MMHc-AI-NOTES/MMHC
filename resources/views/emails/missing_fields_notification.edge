@layout.emailMaster({title: "Missing Fields Notification"})

    @slot('content')
        <mj-section
            background-color="#fff"
            padding-bottom="23px"
            padding-left="48px"
            padding-right="48px"
            padding-top="56px"
            padding="48px"
        >
            <mj-column padding="0">
                <mj-text font-size="30px" line-height="1.5" padding="0px">
                    <strong>Session Fields Missing</strong>
                </mj-text>
                <mj-spacer height="8px">
                </mj-spacer>
                <mj-text font-size="20px" line-height="1.5" padding="0px">
                    Dear {{ practitionerName }},
                </mj-text>
                <mj-spacer height="20px">
                </mj-spacer>
                <mj-text font-size="16px" line-height="1.5" padding="0px">
                    Your session has missing fields. Please update your session with the required information.
                </mj-text>
                <mj-spacer height="20px">
                </mj-spacer>
                @if(missingFields && missingFields.length > 0)
                    <mj-text font-size="16px" line-height="1.5" padding="0px">
                        <strong>Missing Fields:</strong>
                    </mj-text>
                    <mj-spacer height="10px">
                    </mj-spacer>
                    <mj-text font-size="14px" line-height="1.8" padding="0px">
                        <ul style="margin: 0; padding-left: 20px;">
                            @each(field in missingFields)
                                <li>
                                    {{ field }}
                                </li>
                            @endeach
                        </ul>
                    </mj-text>
                @endif
                <mj-spacer height="30px">
                </mj-spacer>
                <mj-text font-size="14px" line-height="1.5" padding="0px" color="#666">
                    Please update your session with the required information.
                </mj-text>
            </mj-column>
        </mj-section>
    @endslot
    
@end
