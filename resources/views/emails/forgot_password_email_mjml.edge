@layout.emailMaster({ title: "Reset your password" })

    @slot('content')
        <mj-section
            background-color="#FFFFFF"
            padding-bottom="56px"
            padding-left="48px"
            padding-right="48px"
            padding-top="56px"
            padding="48px"
        >
            <mj-column padding="0">
                <mj-text font-size="28px" line-height="1.4" padding="0px" color="#1a5f3f" font-weight="600">
                    <strong>Reset your password</strong>
                </mj-text>
                <mj-spacer height="20px">
                </mj-spacer>
                <mj-text font-size="16px" line-height="1.6" padding="0px" color="#4A4A4A">
                    You recently requested to reset your password for your MMHF account.
                </mj-text>
                <mj-spacer height="16px">
                </mj-spacer>
                <mj-text font-size="16px" line-height="1.6" padding="0px" color="#4A4A4A">
