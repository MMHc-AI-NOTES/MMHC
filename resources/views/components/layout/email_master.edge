@mjml()
    <mjml>
        <mj-head>
            <mj-attributes>
                <mj-all font-family="'Barlow', 'Helvetica', 'Arial', sans-serif">
                </mj-all>
                <mj-button background-color="#1a5f3f" border-radius="6px">
                </mj-button>
            </mj-attributes>
            <mj-font
                href="https://fonts.googleapis.com/css?family=Barlow:normal,italic,bold&display=swap"
                name="Barlow"
            >
            </mj-font>
        </mj-head>

        <mj-body width="600px" background-color="#F5F5F5">
            <mj-text font-size="0px">
                {{ new Date().getTime() }}
            </mj-text>

            {{-- add header --}}
            <mj-section padding="0px">
                <mj-column padding="0">
                    <mj-spacer height="32px">
                    </mj-spacer>
                </mj-column>
            </mj-section>
            <mj-section background-color="#1a5f3f" padding="48px">
                <mj-column padding="0">
                    <mj-image
                        align="left"
                        padding="0px"
                        src="{{ companyLogo }}"
                        width="174px"
                        alt="Manhattan Mental Health Counseling"
                    >
                    </mj-image>
                </mj-column>
            </mj-section>

            {{{ await $slots.content() }}}
            <mj-text font-size="0px">
                {{ new Date().getTime() }}
            </mj-text>

            {{-- footer --}}
            <mj-section background-color="transparent" padding="30px 0px">
                <mj-column width="100%">
                    <mj-text
                        color="#6a7f9e"
                        padding="0px"
                        line-height="20px"
                        align="center"
                        font-size="12px"
                        css-class="fd-text"
                    >
                        <p>
                            &copy; 2026 Manhattan Mental Health Counseling. All rights reserved.
                        </p>
                    </mj-text>
                    <mj-spacer height="16px">
                    </mj-spacer>
                </mj-column>
            </mj-section>
        </mj-body>
    </mjml>
@end
