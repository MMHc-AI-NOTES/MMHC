          "name": "S3_DATA_BASE_PATH",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:199990519622:secret:MMH/PROD/Backend-UOoyKE:S3_DATA_BASE_PATH::"
        },
        {
          "name": "AI_REVIEW",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:199990519622:secret:MMH/PROD/Backend-UOoyKE:AI_REVIEW::"
