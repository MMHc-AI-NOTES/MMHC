          "valueFrom": "arn:aws:secretsmanager:us-east-1:199990519622:secret:MMH/PROD/Backend-UOoyKE:AWS_REGION::"
        },
        {
          "name": "AWS_ACCESS_KEY_ID",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:199990519622:secret:MMH/PROD/Backend-UOoyKE:AWS_ACCESS_KEY_ID::"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:199990519622:secret:MMH/PROD/Backend-UOoyKE:AWS_SECRET_ACCESS_KEY::"
        },
        {
          "name": "FRONTEND_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:199990519622:secret:MMH/PROD/Backend-UOoyKE:FRONTEND_URL::"
        },
        {
          "name": "EMAIL_COMPANY_LOGO",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:199990519622:secret:MMH/PROD/Backend-UOoyKE:EMAIL_COMPANY_LOGO::"
        },
