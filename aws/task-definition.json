          "valueFrom": "arn:aws:secretsmanager:us-east-1:199990519622:secret:MMH/PROD/Backend-UOoyKE:MCP_API_URL::"
        },
        {
          "name": "MCP_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:199990519622:secret:MMH/PROD/Backend-UOoyKE:MCP_TOKEN::"
        },
        {
          "name": "BIGQUERY_PROJECT_ID",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:199990519622:secret:MMH/PROD/Backend-UOoyKE:BIGQUERY_PROJECT_ID::"
        },
        {
          "name": "BIGQUERY_CLIENT_EMAIL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:199990519622:secret:MMH/PROD/Backend-UOoyKE:BIGQUERY_CLIENT_EMAIL::"
        },
        {
          "name": "BIGQUERY_PRIVATE_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:199990519622:secret:MMH/PROD/Backend-UOoyKE:BIGQUERY_PRIVATE_KEY::"
        },
        {
          "name": "BIGQUERY_NOTES_TABLE",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:199990519622:secret:MMH/PROD/Backend-UOoyKE:BIGQUERY_NOTES_TABLE::"
        },
        {
          "name": "BIGQUERY_APPOINTMENT_TABLE",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:199990519622:secret:MMH/PROD/Backend-UOoyKE:BIGQUERY_APPOINTMENT_TABLE::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "mmh-backend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "mmh-backend-prod"
        }
      }
    }
  ]
}
