          "valueFrom": "arn:aws:secretsmanager:us-east-1:199990519622:secret:MMH/PROD/Backend-UOoyKE:REDIS_HOST::"
        },
        {
          "name": "REDIS_PORT",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:199990519622:secret:MMH/PROD/Backend-UOoyKE:REDIS_PORT::"
        },
        {
          "name": "REDIS_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:199990519622:secret:MMH/PROD/Backend-UOoyKE:REDIS_PASSWORD::"
        },
        {
          "name": "REDIS_KEY_PREFIX",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:199990519622:secret:MMH/PROD/Backend-UOoyKE:REDIS_KEY_PREFIX::"
        },
        {
          "name": "REDIS_DB",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:199990519622:secret:MMH/PROD/Backend-UOoyKE:REDIS_DB::"
        },
        {
          "name": "EMAIL_TEST",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:199990519622:secret:MMH/PROD/Backend-UOoyKE:EMAIL_TEST::"
        },
        {
          "name": "EMAIL_TEST_ADDRESS",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:199990519622:secret:MMH/PROD/Backend-UOoyKE:EMAIL_TEST_ADDRESS::"
        },
        {
          "name": "INTAKEQ_FORM_NOTE_URL_BASE",
